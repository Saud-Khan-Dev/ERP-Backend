{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=ERP_DB;Username=postgres;Password=YourStrongPassword123!"
  },
  "Jwt": {
    "Issuer": "erp-identity",
    "Audience": "erp",
    "SigningKey": ""
  },
  "FileStorage": {
    "RootPath": "storage"
  },
  "Documents": {
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".tif", ".tiff", ".doc", ".docx", ".xls", ".xlsx" ],
    "PhotoExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "MaxPhotoSizeBytes": 5242880
  },
  "Hrm": {
    "EmployeeNumberPrefix": "EMP",
    "EmployeeNumberSeparator": "-",
    "EmployeeNumberMinimumDigits": 3,
    "PostCodePrefix": "POST",
    "PostCodeMinimumDigits": 4,
    "RetirementAge": 60,
    "AnnualIncrementMonth": 12,
    "AnnualIncrementDay": 1
  },
  "Payroll": {
    "RequireSeparateApprover": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
