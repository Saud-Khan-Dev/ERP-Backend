{
  "RateLimiting": {
    "PermitLimitPer10Seconds": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "property-management-route": {
        "ClusterId": "property-management-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/property-management-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "assets-management-route": {
        "ClusterId": "assets-management-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/assets-management-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/auth-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "hrm-route": {
        "ClusterId": "hrm-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/hrm-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "property-management-cluster": {
        "Destinations": {
          "property-management-api": {
            "Address": "http://localhost:5141"
          }
        }
      },
      "assets-management-cluster": {
        "Destinations": {
          "assets-management-api": {
            "Address": "http://localhost:5139"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:5142"
          }
        }
      },
      "hrm-cluster": {
        "Destinations": {
          "hrm-api": {
            "Address": "http://localhost:5144"
          }
        }
      }
    }
  }
}
