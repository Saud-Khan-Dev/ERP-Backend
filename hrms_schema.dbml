/* =========================================================
   MODULE 1: ORGANIZATION HIERARCHY
   ========================================================= */

Table organization_unit_type {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  code varchar [not null, unique]
  hierarchy_level int
  is_active boolean [not null, default: true]

  Note: '''Configurable catalogue of unit types (Department / Wing / Section / Office / Division). hierarchy_level lives ONLY here; a unit's depth is derived from its parent chain.'''
}

Table location {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  address_line varchar
  city varchar
  district varchar
  province varchar [default: 'Khyber Pakhtunkhwa']
  is_active boolean [not null, default: true]
}

Table organization_unit {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  Note: '''Immutable identity of an org unit. Name, type, parent, location and head live in organization_unit_version so restructuring never destroys history (same pattern as post / post_version).'''
}

Table organization_unit_version {
  id uuid [pk, default: `gen_random_uuid()`]
  org_unit_id uuid [not null]
  unit_type_id uuid [not null]
  parent_unit_id uuid
  name varchar [not null]
  location_id uuid
  head_post_id uuid
  effective_from date [not null]
  effective_to date
  status record_status_enum [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_at timestamptz
  updated_by uuid

  indexes {
    head_post_id [name: 'idx_organization_unit_version_head_post_id']
    location_id [name: 'idx_organization_unit_version_location_id']
    unit_type_id [name: 'idx_organization_unit_version_unit_type_id']
    parent_unit_id [name: 'idx_ouv_parent']
  }

  Note: '''Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

/* =========================================================
   MODULE 2-3: DESIGNATION, PAY SCALE & SANCTIONED POSTS
   ========================================================= */

Table designation {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar [not null, unique]
  code varchar [unique]
  description text
  is_active boolean [not null, default: true]

  Note: '''Pure job-title catalogue. Independent of BPS, org unit and headcount.'''
}

Table pay_scale_grade {
  id uuid [pk, default: `gen_random_uuid()`]
  bps_number int [not null, unique]
  grade_name varchar
  is_active boolean [not null, default: true]
}

Table pay_scale_version {
  id uuid [pk, default: `gen_random_uuid()`]
  grade_id uuid [not null]
  min_basic_pay numeric(14,2) [not null]
  max_basic_pay numeric(14,2) [not null]
  increment_rule text
  version_label varchar
  notification_ref varchar
  effective_from date [not null]
  effective_to date
  status record_status_enum [not null, default: 'active']
  created_by uuid
  approved_by uuid
  created_at timestamptz [not null, default: `now()`]

  Note: '''Versioned pay-scale revisions: a new notification creates a new row. The per-year increment amount is NOT stored here (it was redundant); pay_scale_stage is the single source of truth for stage amounts. Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table pay_scale_stage {
  id uuid [pk, default: `gen_random_uuid()`]
  pay_scale_version_id uuid [not null]
  stage_number int [not null]
  basic_pay numeric(14,2) [not null]

  indexes {
    (pay_scale_version_id, stage_number) [unique, name: 'pay_scale_stage_pay_scale_version_id_stage_number_key']
  }

  Note: '''Annual-increment stage within a pay-scale version, e.g. BPS-17 Stage 4 basic pay.'''
}

Table post {
  id uuid [pk, default: `gen_random_uuid()`]
  post_code varchar [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  Note: '''Immutable identity of a sanctioned post. Mutable attributes live in post_version.'''
}

Table post_version {
  id uuid [pk, default: `gen_random_uuid()`]
  post_id uuid [not null]
  designation_id uuid [not null]
  grade_id uuid [not null]
  org_unit_id uuid [not null]
  reporting_post_id uuid
  employment_type employment_type_enum [not null, default: 'regular']
  location_id uuid
  sanctioned_count int [not null, default: 1]
  lifecycle_status post_lifecycle_enum [not null, default: 'sanctioned']
  notification_ref varchar
  effective_from date [not null]
  effective_to date
  created_at timestamptz [not null, default: `now()`]
  created_by uuid
  approved_by uuid

  indexes {
    designation_id [name: 'idx_post_version_designation_id']
    grade_id [name: 'idx_post_version_grade_id']
    location_id [name: 'idx_post_version_location_id']
    org_unit_id [name: 'idx_pv_org_unit']
    reporting_post_id [name: 'idx_pv_reporting']
  }

  Note: '''One version of a post's attributes. sanctioned_count = number of seats this post identity carries (1 = a single seat; >1 = a pool such as "10 Drivers"). Whether those seats are vacant/filled is DERIVED in v_post_occupancy from position_assignment - it is no longer stored, so it cannot drift. Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

/* =========================================================
   MODULE 4: EMPLOYEE MASTER
   ========================================================= */

Table employee {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_number varchar [not null, unique]
  user_id uuid [unique]
  employment_type employment_type_enum [not null]
  employment_method employment_method_enum
  project_id uuid
  first_name varchar [not null]
  middle_name varchar
  last_name varchar
  full_name varchar [note: 'Generated column: first_name + middle_name + last_name (STORED)']
  cnic varchar [not null, unique, note: 'Accepts 13 digits with or without dashes (35202-1234567-1). Normalise in the application so the UNIQUE index is meaningful.']
  date_of_birth date
  gender gender_enum
  nationality varchar [default: 'Pakistani']
  marital_status marital_status_enum
  blood_group varchar
  profile_status record_status_enum [not null, default: 'active']
  employment_status employment_status_enum [not null, default: 'active']
  photo_reference varchar
  created_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_at timestamptz
  updated_by uuid

  indexes {
    employment_status [name: 'idx_employee_status']
    employment_type [name: 'idx_employee_type']
  }

  Note: '''Core identity only. full_name is a generated column. CNIC is stored in plain text (needed for uniqueness/search): protect with column privileges (see security section) and disk/backup encryption.'''
}

Table employee_pay_record {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  pay_scale_stage_id uuid [not null]
  basic_pay numeric(14,2) [not null]
  last_increment_date date
  next_increment_date date
  reason varchar
  order_number varchar
  effective_from date [not null]
  effective_to date
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    pay_scale_stage_id [name: 'idx_employee_pay_record_pay_scale_stage_id']
  }

  Note: '''Effective-dated pay position of an employee (stage + actual basic pay). Annual increments close the current row and open the next stage. Payroll reads Basic Pay from here. Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table employee_contact {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  contact_type contact_type_enum [not null]
  value varchar [not null]
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (employee_id, contact_type) [unique, name: 'uq_employee_contact_primary', note: 'partial index, WHERE is_primary']
  }
}

Table employee_address {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  address_type address_type_enum [not null]
  address_line varchar
  city varchar
  district varchar
  province varchar
  postal_code varchar
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (employee_id, address_type) [unique, name: 'uq_employee_address_type', note: 'partial index, WHERE (address_type IN (\'permanent\', \'current\'))']
  }
}

Table employee_emergency_contact {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  name varchar [not null]
  relation varchar
  phone varchar
  created_at timestamptz [not null, default: `now()`]

  indexes {
    employee_id [name: 'idx_employee_emergency_contact_employee_id']
  }
}

Table employee_family_member {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  relation varchar
  name varchar
  date_of_birth date
  cnic varchar
  occupation varchar
  created_at timestamptz [not null, default: `now()`]

  indexes {
    employee_id [name: 'idx_employee_family_member_employee_id']
  }
}

Table employee_bank_account {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  bank_name varchar [not null]
  branch_name varchar
  account_number varchar
  iban varchar
  is_primary boolean [not null, default: true]
  status record_status_enum [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_at timestamptz
  updated_by uuid

  indexes {
    (id, employee_id) [unique, name: 'employee_bank_account_id_employee_id_key']
    employee_id [unique, name: 'uq_eba_one_primary', note: 'partial index, WHERE (is_primary AND (status = \'active\'))']
  }

  Note: '''Restricted-access table; not joined into general reporting views. Payment rows snapshot these values at payment time.'''
}

/* =========================================================
   MODULE 5-6: DOCUMENTS, EDUCATION & RECRUITMENT
   ========================================================= */

Table document_type {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  requires_expiry boolean [not null, default: false]
  is_active boolean [not null, default: true]
}

Table employee_document {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  document_type_id uuid [not null]
  document_number varchar
  issue_date date
  expiry_date date
  file_reference varchar [not null]
  verification_status verification_status_enum [not null, default: 'unverified']
  verified_by uuid
  verification_date date
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    (employee_id, document_type_id) [name: 'idx_ed_employee']
    expiry_date [name: 'idx_ed_expiry', note: 'partial index, WHERE (expiry_date IS NOT NULL)']
    document_type_id [name: 'idx_employee_document_document_type_id']
  }
}

Table employee_education {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  qualification_level qualification_level_enum [not null]
  degree_title varchar [not null]
  institution_name varchar [not null]
  board_or_university varchar
  passing_year int
  grade_or_cgpa varchar
  is_highest_qualification boolean [not null, default: false]
  file_reference varchar
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    (employee_id, qualification_level) [name: 'idx_edu_employee_level']
    employee_id [unique, name: 'uq_edu_one_highest', note: 'partial index, WHERE is_highest_qualification']
  }
}

Table recruitment_method {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  is_active boolean [not null, default: true]

  Note: '''Project Regularization / Board of Authority / Public Service (CSS, PMS ...). Referenced from employee_service_history.'''
}

/* =========================================================
   MODULE 7: EMPLOYMENT HISTORY
   ========================================================= */

Table service_event_type {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  category varchar
  is_active boolean [not null, default: true]
}

Table employee_service_history {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  event_type_id uuid [not null]
  effective_date date [not null]
  old_post_id uuid
  new_post_id uuid
  old_grade_id uuid
  new_grade_id uuid
  old_org_unit_id uuid
  new_org_unit_id uuid
  recruitment_method_id uuid
  external_reference_org varchar
  order_number varchar
  supporting_document_id uuid
  reason text
  remarks text
  created_by uuid
  approved_by uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    new_grade_id [name: 'idx_employee_service_history_new_grade_id']
    new_org_unit_id [name: 'idx_employee_service_history_new_org_unit_id']
    new_post_id [name: 'idx_employee_service_history_new_post_id']
    old_grade_id [name: 'idx_employee_service_history_old_grade_id']
    old_org_unit_id [name: 'idx_employee_service_history_old_org_unit_id']
    old_post_id [name: 'idx_employee_service_history_old_post_id']
    recruitment_method_id [name: 'idx_employee_service_history_recruitment_method_id']
    supporting_document_id [name: 'idx_employee_service_history_supporting_document_id']
    (employee_id, effective_date) [name: 'idx_esh_employee_date']
    event_type_id [name: 'idx_esh_event']
  }

  Note: '''Append-only service ledger: ONE row per service event (appointment, transfer, promotion, deputation ...). It records WHAT happened and why. The resulting occupancy of a post is recorded in position_assignment (the two tables complement each other). UPDATE/DELETE are blocked by trigger; corrections are offsetting rows.'''
}

Table position_assignment {
  id uuid [pk, default: `gen_random_uuid()`]
  post_id uuid [not null]
  employee_id uuid [not null]
  assignment_type assignment_type_enum [not null, default: 'regular']
  service_history_id uuid
  order_number varchar
  order_document_id uuid
  effective_from date [not null]
  effective_to date
  status record_status_enum [not null, default: 'active']
  remarks text
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    employee_id [name: 'idx_pa_employee']
    (post_id, effective_from) [name: 'idx_pa_post_from']
    order_document_id [name: 'idx_position_assignment_order_document_id']
    service_history_id [name: 'idx_position_assignment_service_history_id']
  }

  Note: '''Employee occupancy of a sanctioned post. Acting / additional-charge assignments can coexist with a regular one. A trigger stops regular assignments exceeding the post's sanctioned_count and refuses frozen / abolished posts. Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table hr_action_request {
  id uuid [pk, default: `gen_random_uuid()`]
  action_type hr_action_type_enum [not null]
  employee_id uuid [not null]
  old_post_id uuid
  new_post_id uuid
  old_grade_id uuid
  new_grade_id uuid
  old_org_unit_id uuid
  new_org_unit_id uuid
  effective_date date [not null]
  order_number varchar
  reason text
  supporting_document_id uuid
  status hr_action_status_enum [not null, default: 'draft']
  approval_request_id uuid
  approved_by uuid
  approved_at timestamptz
  resulting_service_history_id uuid
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by uuid

  indexes {
    (employee_id, effective_date) [name: 'idx_har_employee']
    status [name: 'idx_har_status']
    new_grade_id [name: 'idx_hr_action_request_new_grade_id']
    new_org_unit_id [name: 'idx_hr_action_request_new_org_unit_id']
    new_post_id [name: 'idx_hr_action_request_new_post_id']
    old_grade_id [name: 'idx_hr_action_request_old_grade_id']
    old_org_unit_id [name: 'idx_hr_action_request_old_org_unit_id']
    old_post_id [name: 'idx_hr_action_request_old_post_id']
    resulting_service_history_id [name: 'idx_hr_action_request_resulting_service_history_id']
    supporting_document_id [name: 'idx_hr_action_request_supporting_document_id']
  }

  Note: '''Draft/pending HR change. Routed through the platform approval workflow (approval_request_id is a plain uuid pointer). When applied, an employee_service_history row is written and linked in resulting_service_history_id.'''
}

Table employee_separation {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  separation_type separation_type_enum [not null]
  separation_date date [not null]
  service_history_id uuid
  settlement_payroll_transaction_id uuid
  order_number varchar
  reason text
  notice_period_days int
  final_settlement_amount numeric(14,2)
  outstanding_loan_amount numeric(14,2)
  leave_encashment_amount numeric(14,2)
  pension_reference varchar
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    service_history_id [name: 'idx_employee_separation_service_history_id']
    settlement_payroll_transaction_id [name: 'idx_employee_separation_settlement_payroll_transaction_id']
    employee_id [unique, name: 'uq_separation_employee']
  }
}

/* =========================================================
   MODULE 8: PERFORMANCE MANAGEMENT
   ========================================================= */

Table performance_period {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  start_date date [not null]
  end_date date [not null]
  status record_status_enum [not null, default: 'active']

  Note: '''Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table performance_review {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  performance_period_id uuid [not null]
  evaluator_id uuid [not null]
  status review_status_enum [not null, default: 'draft']
  final_score numeric(6,2)
  performance_grade varchar
  promotion_recommended boolean [not null, default: false]
  training_recommended boolean [not null, default: false]
  remarks text
  created_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_at timestamptz
  updated_by uuid

  indexes {
    (employee_id, performance_period_id) [unique, name: 'performance_review_employee_id_performance_period_id_key']
    performance_period_id [name: 'idx_performance_review_performance_period_id']
    evaluator_id [name: 'idx_pr_evaluator']
  }
}

Table performance_goal {
  id uuid [pk, default: `gen_random_uuid()`]
  performance_review_id uuid [not null]
  description text [not null]
  weight numeric(5,2) [not null, default: 0]
  target text
  achievement text
  score numeric(6,2)

  indexes {
    performance_review_id [name: 'idx_performance_goal_performance_review_id']
  }
}

Table performance_kpi {
  id uuid [pk, default: `gen_random_uuid()`]
  performance_review_id uuid [not null]
  kpi_name varchar [not null]
  target_value varchar
  achieved_value varchar
  score numeric(6,2)

  indexes {
    performance_review_id [name: 'idx_performance_kpi_performance_review_id']
  }
}

Table performance_competency {
  id uuid [pk, default: `gen_random_uuid()`]
  performance_review_id uuid [not null]
  competency_name varchar [not null]
  rating numeric(4,2)
  remarks text

  indexes {
    performance_review_id [name: 'idx_performance_competency_performance_review_id']
  }
}

/* =========================================================
   MODULE 9: ATTENDANCE, SHIFTS & HOLIDAYS
   ========================================================= */

Table work_shift {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  start_time time [not null]
  end_time time [not null]
  grace_minutes int [not null, default: 0]
  working_weekdays smallint[] [not null, default: '{1,2,3,4,5}']
  is_active boolean [not null, default: true]
}

Table employee_shift {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  work_shift_id uuid [not null]
  effective_from date [not null]
  effective_to date

  indexes {
    work_shift_id [name: 'idx_employee_shift_work_shift_id']
  }

  Note: '''Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table holiday_calendar {
  id uuid [pk, default: `gen_random_uuid()`]
  holiday_date date [not null]
  name varchar [not null]
  holiday_type holiday_type_enum [not null, default: 'public']
  location_id uuid
  notification_ref varchar

  indexes {
    (holiday_date, name, location_id) [unique, name: 'holiday_calendar_holiday_date_name_location_id_key']
    location_id [name: 'idx_holiday_calendar_location_id']
    holiday_date [name: 'idx_holiday_date']
  }
}

Table attendance_record {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  attendance_date date [not null]
  work_shift_id uuid
  check_in time
  check_out time
  working_hours numeric(5,2)
  overtime_hours numeric(5,2)
  late_minutes int [not null, default: 0]
  early_departure_minutes int [not null, default: 0]
  status attendance_status_enum
  remarks text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    (employee_id, attendance_date) [unique, name: 'attendance_record_employee_id_attendance_date_key']
    attendance_date [name: 'idx_att_date']
    work_shift_id [name: 'idx_attendance_record_work_shift_id']
  }
}

/* =========================================================
   MODULE 10: LEAVE MANAGEMENT
   ========================================================= */

Table leave_type {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  is_paid boolean [not null, default: true]
  max_days_per_year numeric(6,2)
  accrual_rule text
  carry_forward_allowed boolean [not null, default: false]
  affects_payroll boolean [not null, default: false]
}

Table leave_entitlement {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  leave_type_id uuid [not null]
  year int [not null]
  entitled_days numeric(6,2) [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    (employee_id, leave_type_id, year) [unique, name: 'leave_entitlement_employee_id_leave_type_id_year_key']
    leave_type_id [name: 'idx_leave_entitlement_leave_type_id']
  }
}

Table leave_application {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  leave_type_id uuid [not null]
  start_date date [not null]
  end_date date [not null]
  days numeric(6,2) [not null]
  status leave_status_enum [not null, default: 'pending']
  applied_date date [not null, default: `current_date`]
  approved_by uuid
  approval_date date
  reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by uuid

  indexes {
    (employee_id, start_date) [name: 'idx_la_employee_start']
    status [name: 'idx_la_status']
    leave_type_id [name: 'idx_leave_application_leave_type_id']
  }

  Note: '''Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table leave_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  leave_type_id uuid [not null]
  year int [not null]
  txn_type leave_txn_type_enum [not null]
  days numeric(6,2) [not null]
  txn_date date [not null, default: `current_date`]
  leave_application_id uuid
  remarks text
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    leave_application_id [name: 'idx_leave_ledger_leave_application_id']
    leave_type_id [name: 'idx_leave_ledger_leave_type_id']
    (employee_id, leave_type_id, year) [name: 'idx_ll_emp_type_year']
  }

  Note: '''Append-only leave transactions (accrual, usage, carry-forward, lapse, encashment, adjustment). Balances are derived, so they can always be audited.'''
}

/* =========================================================
   MODULE 11-12: SALARY STRUCTURE & INCOME TAX
   ========================================================= */

Table salary_component {
  id uuid [pk, default: `gen_random_uuid()`]
  component_code varchar [not null, unique]
  component_name varchar [not null]
  component_type component_type_enum [not null]
  is_taxable boolean [not null, default: true]
  is_active boolean [not null, default: true]

  Note: '''Pay components from the Officers' pay slip. EARNING: Basic Pay, GDA Authority Allowance, Medical Allowance, Housing Subsidy, Utility Allowance, Adhoc Relief Allowance (one row per notification year). DEDUCTION: BF, GP Fund, MCA, GPF Advance, RB&D, Income Tax.'''
}

Table salary_component_rule {
  id uuid [pk, default: `gen_random_uuid()`]
  salary_component_id uuid [not null]
  rule_version varchar [not null]
  calculation_method calculation_method_enum [not null]
  fixed_amount numeric(14,2)
  percentage numeric(6,3)
  calculation_base varchar
  formula_expression text
  min_bps int
  max_bps int
  applicable_designation_id uuid
  applicable_org_unit_id uuid
  applicable_employment_type employment_type_enum
  min_amount numeric(14,2)
  max_amount numeric(14,2)
  priority int [not null, default: 100]
  notification_ref varchar
  effective_from date [not null]
  effective_to date
  status record_status_enum [not null, default: 'active']
  created_by uuid
  approved_by uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (salary_component_id, rule_version) [unique, name: 'salary_component_rule_salary_component_id_rule_version_key']
    applicable_designation_id [name: 'idx_salary_component_rule_applicable_designation_id']
    applicable_org_unit_id [name: 'idx_salary_component_rule_applicable_org_unit_id']
    (salary_component_id, effective_from) [name: 'idx_scr_component_from']
  }

  Note: '''Versioned, scoped rules. Several rules of one component may overlap in time when their scope differs (designation / BPS range / org unit / employment type); priority breaks ties, so no time-exclusion is enforced here. Each Adhoc Relief year is its own component.'''
}

Table employee_salary_component {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  salary_component_id uuid [not null]
  post_id uuid
  override_fixed_amount numeric(14,2)
  override_percentage numeric(6,3)
  effective_from date [not null]
  effective_to date
  remarks text
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    post_id [name: 'idx_employee_salary_component_post_id']
    salary_component_id [name: 'idx_employee_salary_component_salary_component_id']
  }

  Note: '''Employee-specific overrides of the standard rule. Exactly one of fixed amount / percentage. Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table tax_year {
  id uuid [pk, default: `gen_random_uuid()`]
  year_label varchar [not null, unique]
  start_date date [not null]
  end_date date [not null]
  status record_status_enum [not null, default: 'active']

  Note: '''Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table tax_slab {
  id uuid [pk, default: `gen_random_uuid()`]
  tax_year_id uuid [not null]
  slab_order int [not null]
  min_income numeric(14,2) [not null]
  max_income numeric(14,2)
  fixed_amount numeric(14,2) [not null, default: 0]
  rate_percentage numeric(6,3) [not null, default: 0]

  indexes {
    (tax_year_id, slab_order) [unique, name: 'tax_slab_tax_year_id_slab_order_key']
  }

  Note: '''Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table employee_tax_exemption {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  tax_year_id uuid [not null]
  exemption_type varchar [not null]
  amount numeric(14,2) [not null]

  indexes {
    (employee_id, tax_year_id, exemption_type) [unique, name: 'employee_tax_exemption_employee_id_tax_year_id_exemption_ty_key']
    tax_year_id [name: 'idx_employee_tax_exemption_tax_year_id']
  }
}

Table employee_tax_ledger {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  tax_year_id uuid [not null]
  payroll_transaction_id uuid [not null, unique]
  taxable_income numeric(14,2) [not null]
  tax_withheld numeric(14,2) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    tax_year_id [name: 'idx_employee_tax_ledger_tax_year_id']
    (employee_id, tax_year_id) [name: 'idx_etl_emp_year']
  }
}

/* =========================================================
   MODULE 13: LOANS / ADVANCES & GP FUND
   ========================================================= */

Table loan_type {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  salary_component_id uuid
  is_gpf_advance boolean [not null, default: false]
  default_interest_rate numeric(6,3) [not null, default: 0]
  is_active boolean [not null, default: true]

  indexes {
    salary_component_id [name: 'idx_loan_type_salary_component_id']
  }

  Note: '''e.g. Motor Car Advance (MCA), GP Fund Advance. salary_component_id says which pay-slip deduction line carries the installment, so the loan is never double counted.'''
}

Table employee_loan {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  loan_type_id uuid [not null]
  principal_amount numeric(14,2) [not null]
  interest_amount numeric(14,2) [not null, default: 0]
  installments_count int [not null]
  monthly_installment numeric(14,2) [not null]
  start_date date [not null]
  end_date date
  remaining_balance numeric(14,2) [not null]
  deduction_priority int [not null, default: 100]
  status loan_status_enum [not null, default: 'active']
  approved_by uuid
  created_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_at timestamptz
  updated_by uuid

  indexes {
    (employee_id, status) [name: 'idx_el_employee_status']
    loan_type_id [name: 'idx_employee_loan_loan_type_id']
  }
}

Table loan_installment_schedule {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_loan_id uuid [not null]
  installment_number int [not null]
  due_date date [not null]
  amount numeric(14,2) [not null]
  paid_amount numeric(14,2) [not null, default: 0]
  status installment_status_enum [not null, default: 'pending']

  indexes {
    (employee_loan_id, installment_number) [unique, name: 'loan_installment_schedule_employee_loan_id_installment_numb_key']
    (id, employee_loan_id) [unique, name: 'uq_lis_id_loan']
    due_date [name: 'idx_lis_due', note: 'partial index, WHERE (status IN (\'pending\', \'partial\'))']
  }
}

Table gp_fund_account {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null, unique]
  account_number varchar [unique]
  opened_on date [not null]
  closed_on date
  monthly_subscription numeric(14,2) [not null, default: 0]
  status record_status_enum [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
}

Table gp_fund_interest_rate {
  id uuid [pk, default: `gen_random_uuid()`]
  fiscal_year varchar [not null]
  rate_percent numeric(6,3) [not null]
  notification_ref varchar
  effective_from date [not null]
  effective_to date

  Note: '''Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table gp_fund_transaction {
  id uuid [pk, default: `gen_random_uuid()`]
  gp_fund_account_id uuid [not null]
  txn_type gpf_txn_type_enum [not null]
  txn_date date [not null]
  amount numeric(14,2) [not null]
  employee_loan_id uuid
  payroll_transaction_id uuid
  remarks text
  created_at timestamptz [not null, default: `now()`]
  created_by uuid

  indexes {
    employee_loan_id [name: 'idx_gp_fund_transaction_employee_loan_id']
    payroll_transaction_id [name: 'idx_gp_fund_transaction_payroll_transaction_id']
    (gp_fund_account_id, txn_date) [name: 'idx_gpt_account_date']
  }
}

/* =========================================================
   MODULE 14-15: PAYROLL ENGINE & PAYMENT
   ========================================================= */

Table payroll_period {
  id uuid [pk, default: `gen_random_uuid()`]
  year int [not null]
  month int [not null]
  start_date date [not null]
  end_date date [not null]
  status payroll_period_status_enum [not null, default: 'open']

  indexes {
    (year, month) [unique, name: 'payroll_period_year_month_key']
  }
}

Table payroll_run {
  id uuid [pk, default: `gen_random_uuid()`]
  payroll_period_id uuid [not null]
  run_type payroll_run_type_enum [not null, default: 'regular']
  run_label varchar
  status payroll_run_status_enum [not null, default: 'draft']
  reverses_run_id uuid
  prepared_by uuid
  reviewed_by uuid
  approved_by uuid
  approval_date timestamptz
  finalization_date timestamptz
  payment_date timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    reverses_run_id [name: 'idx_payroll_run_reverses_run_id']
    status [name: 'idx_payroll_run_status']
    payroll_period_id [unique, name: 'uq_payroll_run_regular', note: 'partial index, WHERE ((run_type = \'regular\') AND (status <> \'reversed\'))']
  }

  Note: '''One live regular run per period (partial unique index); extra runs use run_type. Locked once finalized: child rows are protected by triggers. Status moves only along the allowed workflow.'''
}

Table payroll_transaction {
  id uuid [pk, default: `gen_random_uuid()`]
  payroll_run_id uuid [not null]
  employee_id uuid [not null]
  days_payable numeric(5,2)
  gross_pay numeric(14,2) [not null, default: 0]
  total_deductions numeric(14,2) [not null, default: 0]
  net_payable numeric(14,2) [not null, default: 0]
  status payroll_txn_status_enum [not null, default: 'calculated']
  remarks text

  indexes {
    (payroll_run_id, employee_id) [unique, name: 'payroll_transaction_payroll_run_id_employee_id_key']
    employee_id [name: 'idx_pt_employee']
  }

  Note: '''Pay-slip header: one row per employee per run. Post / grade changes inside the month are carried by payroll_transaction_segment (so proration across two posts is possible).'''
}

Table payroll_transaction_segment {
  id uuid [pk, default: `gen_random_uuid()`]
  payroll_transaction_id uuid [not null]
  post_id uuid [not null]
  grade_id uuid [not null]
  pay_scale_stage_id uuid
  basic_pay numeric(14,2) [not null]
  period_from date [not null]
  period_to date [not null]
  days numeric(5,2) [not null]

  indexes {
    grade_id [name: 'idx_payroll_transaction_segment_grade_id']
    pay_scale_stage_id [name: 'idx_payroll_transaction_segment_pay_scale_stage_id']
    post_id [name: 'idx_payroll_transaction_segment_post_id']
  }

  Note: '''One row per post/grade/stage the employee held within the pay period (mid-month transfer, promotion, acting charge ...). Also enforced in SQL: 1 EXCLUDE constraint(s) preventing overlapping date ranges / duplicate occupancy.'''
}

Table payroll_loan_deduction {
  id uuid [pk, default: `gen_random_uuid()`]
  payroll_transaction_id uuid [not null]
  employee_loan_id uuid [not null]
  installment_id uuid [not null, unique]
  installment_amount numeric(14,2) [not null]

  indexes {
    employee_loan_id [name: 'idx_payroll_loan_deduction_employee_loan_id']
    (installment_id, employee_loan_id) [name: 'idx_payroll_loan_deduction_installment_id_employee_loan_id']
    payroll_transaction_id [name: 'idx_payroll_loan_deduction_payroll_transaction_id']
  }
}

Table payroll_component_detail {
  id uuid [pk, default: `gen_random_uuid()`]
  payroll_transaction_id uuid [not null]
  segment_id uuid
  salary_component_id uuid [not null]
  salary_component_rule_id uuid
  source component_source_enum [not null, default: 'rule']
  payroll_loan_deduction_id uuid [unique]
  component_type component_type_enum [not null]
  calculation_base varchar
  base_amount numeric(14,2)
  rate numeric(6,3)
  formula_reference text
  calculated_amount numeric(14,2) [not null]
  notification_ref varchar
  effective_date date

  indexes {
    salary_component_id [name: 'idx_payroll_component_detail_salary_component_id']
    salary_component_rule_id [name: 'idx_payroll_component_detail_salary_component_rule_id']
    segment_id [name: 'idx_payroll_component_detail_segment_id']
    payroll_transaction_id [name: 'idx_pcd_txn']
  }

  Note: '''One pay-slip line. Loan / advance deductions (MCA, GPF Adv) appear here ONCE with source='loan' and a link to payroll_loan_deduction, which links to the exact installment - so no double counting and full reconciliation.'''
}

Table payroll_adjustment {
  id uuid [pk, default: `gen_random_uuid()`]
  payroll_transaction_id uuid [not null]
  adjustment_type adjustment_type_enum [not null]
  amount numeric(14,2) [not null]
  reason text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    payroll_transaction_id [name: 'idx_payroll_adjustment_payroll_transaction_id']
  }
}

Table payslip {
  id uuid [pk, default: `gen_random_uuid()`]
  payroll_transaction_id uuid [not null, unique]
  snapshot_json jsonb [not null]
  generated_at timestamptz [not null, default: `now()`]
  file_reference varchar
}

Table payroll_payment {
  id uuid [pk, default: `gen_random_uuid()`]
  payroll_transaction_id uuid [not null]
  employee_id uuid [not null]
  bank_account_id uuid [not null]
  bank_name_snapshot varchar
  branch_name_snapshot varchar
  account_number_snapshot varchar
  iban_snapshot varchar
  payment_method payment_method_enum [not null, default: 'bank_transfer']
  payment_status payment_status_enum [not null, default: 'pending']
  payment_date date
  payment_reference varchar
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (bank_account_id, employee_id) [name: 'idx_payroll_payment_bank_account_id_employee_id']
    employee_id [name: 'idx_payroll_payment_employee_id']
    bank_account_id [name: 'idx_pp_bank']
    payroll_transaction_id [unique, name: 'uq_pp_one_live', note: 'partial index, WHERE (payment_status IN (\'pending\', \'processed\'))']
  }

  Note: '''Restricted-access (holds bank details). Destination snapshot is filled by trigger on insert; composite FK guarantees the account belongs to the paid employee.'''
}

/* =========================================================
   MODULE 16-17: TASKS & EMPLOYEE REQUESTS
   ========================================================= */

Table employee_task {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  assigned_by uuid [not null]
  title varchar [not null]
  description text
  priority task_priority_enum [not null, default: 'medium']
  due_date date
  status task_status_enum [not null, default: 'pending']
  progress_percentage int [not null, default: 0]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    due_date [name: 'idx_et_due']
    employee_id [name: 'idx_et_employee']
    status [name: 'idx_et_status']
  }

  Note: '''Lightweight task assignment for the Employee Portal. progress_percentage is maintained BY TRIGGER from employee_task_update.'''
}

Table employee_task_update {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null]
  progress_percentage int [not null]
  notes text
  updated_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (task_id, created_at) [name: 'idx_etu_task']
  }
}

Table employee_request_type {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  code varchar [unique]
  requires_document boolean [not null, default: false]
  is_active boolean [not null, default: true]
}

Table employee_request {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null]
  request_type_id uuid [not null]
  subject varchar
  description text
  requested_data jsonb
  supporting_document_id uuid
  status employee_request_status_enum [not null, default: 'pending']
  submitted_at timestamptz [not null, default: `now()`]
  reviewed_by uuid
  reviewed_at timestamptz
  remarks text

  indexes {
    supporting_document_id [name: 'idx_employee_request_supporting_document_id']
    employee_id [name: 'idx_er_employee']
    status [name: 'idx_er_status']
    request_type_id [name: 'idx_er_type']
  }
}

// ---------------------------------------------------------------------
// RELATIONSHIPS  (> many-to-one, - one-to-one)
// ---------------------------------------------------------------------

Ref: organization_unit_version.head_post_id > post.id
Ref: organization_unit_version.location_id > location.id
Ref: organization_unit_version.org_unit_id > organization_unit.id
Ref: organization_unit_version.parent_unit_id > organization_unit.id
Ref: organization_unit_version.unit_type_id > organization_unit_type.id

Ref: pay_scale_version.grade_id > pay_scale_grade.id

Ref: pay_scale_stage.pay_scale_version_id > pay_scale_version.id

Ref: post_version.designation_id > designation.id
Ref: post_version.grade_id > pay_scale_grade.id
Ref: post_version.location_id > location.id
Ref: post_version.org_unit_id > organization_unit.id
Ref: post_version.post_id > post.id
Ref: post_version.reporting_post_id > post.id

Ref: employee_pay_record.employee_id > employee.id
Ref: employee_pay_record.pay_scale_stage_id > pay_scale_stage.id

Ref: employee_contact.employee_id > employee.id

Ref: employee_address.employee_id > employee.id

Ref: employee_emergency_contact.employee_id > employee.id

Ref: employee_family_member.employee_id > employee.id

Ref: employee_bank_account.employee_id > employee.id

Ref: employee_document.document_type_id > document_type.id
Ref: employee_document.employee_id > employee.id

Ref: employee_education.employee_id > employee.id

Ref: employee_service_history.employee_id > employee.id
Ref: employee_service_history.event_type_id > service_event_type.id
Ref: employee_service_history.new_grade_id > pay_scale_grade.id
Ref: employee_service_history.new_org_unit_id > organization_unit.id
