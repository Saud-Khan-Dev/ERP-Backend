// =====================================================================
// GDA HRMS ERP - dbdiagram.io (DBML) version of hrms_schema.sql
// Generated from the live PostgreSQL catalog, so it matches the SQL exactly.
// =====================================================================

Project GDA_HRMS_ERP {
  database_type: 'PostgreSQL'
  Note: '''
    Galiyat Development Authority (GDA) - Government of Khyber Pakhtunkhwa
    Production-grade HRMS module of the GDA ERP (single-tenant, schema "hrms").

    Conventions: ids are uuid (default gen_random_uuid()); money is numeric(14,2);
    every *_by column is a platform users.id (plain uuid, no cross-schema FK).
    Effective-dated tables close the old row and insert a new one.

    NOT drawn here because DBML cannot express them (they live in hrms_schema.sql):
    EXCLUDE constraints (no overlapping date ranges), CHECK constraints, triggers
    (append-only ledgers, payroll run locking, post capacity, loan posting) and views
    (v_employee_tax_ytd, v_gp_fund_balance, v_leave_balance, v_organization_unit_current, v_post_occupancy).
  '''
}

