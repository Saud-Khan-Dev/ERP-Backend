// ---------------------------------------------------------------------
// TABLE GROUPS (colour-coded boxes in dbdiagram.io)
// ---------------------------------------------------------------------

TableGroup organization {
  organization_unit_type
  location
  organization_unit
  organization_unit_version
}

TableGroup pay_scale_and_posts {
  designation
  pay_scale_grade
  pay_scale_version
  pay_scale_stage
  post
  post_version
}

TableGroup employee_master {
  employee
  employee_pay_record
  employee_contact
  employee_address
  employee_emergency_contact
  employee_family_member
  employee_bank_account
}

TableGroup documents_education {
  document_type
  employee_document
  employee_education
  recruitment_method
}

TableGroup service_history {
  service_event_type
  employee_service_history
  position_assignment
  hr_action_request
  employee_separation
}

TableGroup performance {
  performance_period
  performance_review
  performance_goal
  performance_kpi
  performance_competency
}

TableGroup attendance {
  work_shift
  employee_shift
  holiday_calendar
  attendance_record
}

TableGroup leave {
  leave_type
  leave_entitlement
  leave_application
  leave_ledger
}

TableGroup salary_and_tax {
  salary_component
  salary_component_rule
  employee_salary_component
  tax_year
  tax_slab
  employee_tax_exemption
  employee_tax_ledger
}

TableGroup loans_and_gpf {
  loan_type
  employee_loan
  loan_installment_schedule
  gp_fund_account
  gp_fund_interest_rate
  gp_fund_transaction
}

TableGroup payroll {
  payroll_period
  payroll_run
  payroll_transaction
  payroll_transaction_segment
  payroll_loan_deduction
  payroll_component_detail
  payroll_adjustment
  payslip
  payroll_payment
}

TableGroup tasks_and_requests {
  employee_task
  employee_task_update
  employee_request_type
  employee_request
}
