TableGroup taxation_organisation {
  taxation.tax_circle
  taxation.tax_circle_town
  taxation.tax_circle_staff
}
TableGroup taxation_rates {
  taxation.tax_head
  taxation.category_map
  taxation.rate_set
  taxation.ltf_factor
  taxation.rate_band
