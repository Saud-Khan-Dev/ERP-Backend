// =====================================================================
// RELATIONSHIPS — across services (LOGICAL ONLY: no database FK).
// Drawn so the diagram shows the dependency. When generating SQL for the
// taxation schema, drop every Ref below.
// =====================================================================

Ref: taxation.tax_circle.org_unit_id > hrms.organization_unit.id  // logical
Ref: taxation.tax_circle.officer_post_id > hrms.post.id  // logical
Ref: taxation.tax_circle_staff.post_id > hrms.post.id  // logical
Ref: taxation.tax_circle_town.town_id > property.town.id  // logical
Ref: taxation.category_map.property_type_id - property.property_type.id  // logical
Ref: taxation.ltf_factor.town_id > property.town.id  // logical
Ref: taxation.rate_band.town_id > property.town.id  // logical
Ref: taxation.tax_file.property_id - property.property.id  // logical
Ref: taxation.tax_file.town_id > property.town.id  // logical
Ref: taxation.tax_file_basis.source_measurement_id > property.property_measurement.id  // logical
Ref: taxation.tax_file_basis.source_building_plan_id > property.building_plan.id  // logical
Ref: taxation.tax_file_basis.completion_plan_id > property.building_plan.id  // logical
Ref: taxation.tax_file_basis.property_type_id > property.property_type.id  // logical
Ref: taxation.tax_file_payer.owner_id > property.property_owner.id  // logical
Ref: taxation.agreement_schedule.source_id > property.property_lease.id  // logical, when kind = LEASE
Ref: taxation.non_utilization_case.allotment_id > property.property_allotment.id  // logical
Ref: taxation.malba_security.building_plan_id > property.building_plan.id  // logical
Ref: taxation.clearance.property_ref_id > property.property_transfer.id  // logical, when purpose = TRANSFER
Ref: taxation.penalty.violation_id > property.agreement_violation.id  // logical
Ref: taxation.litigation_hold.source_litigation_id > property.property_litigation.id  // logical
Ref: taxation.party.owner_id > property.property_owner.id  // logical
Ref: taxation.party.employee_id > hrms.employee.id  // logical
Ref: taxation.sms_message.owner_id > property.property_owner.id  // logical
Ref: taxation.notice.signing_post_id > hrms.post.id  // logical
Ref: taxation.notice.signing_employee_id > hrms.employee.id  // logical
Ref: taxation.notice.served_by_employee_id > hrms.employee.id  // logical
Ref: taxation.sealing.ordered_by_employee_id > hrms.employee.id  // logical
Ref: taxation.water_connection.inspected_by_employee_id > hrms.employee.id  // logical
Ref: taxation.demand_run.approved_by > auth.users.id  // logical
Ref: taxation.clearance.issued_by > auth.users.id  // logical
Ref: taxation.audit_log.user_id > auth.users.id  // logical
Ref: taxation.arrears.entered_by > auth.users.id  // logical
Ref: taxation.rate_set.approved_by > auth.users.id  // logical
Ref: taxation.penalty_run.approved_by > auth.users.id  // logical
Ref: taxation.tax_file_override.approved_by > auth.users.id  // logical
Ref: taxation.notice.confirmed_by > auth.users.id  // logical
Ref: taxation.payment.received_by > auth.users.id  // logical
Ref: taxation.demand_run.computed_by > auth.users.id  // logical
Ref: taxation.import_batch.imported_by > auth.users.id  // logical
Ref: taxation.import_row.matched_property_id > property.property.id  // logical

// External relationships among the stubs (owned and enforced by their services)
Ref: property.property.town_id > property.town.id
Ref: property.property.property_type_id > property.property_type.id
Ref: property.property_measurement.property_id > property.property.id
Ref: property.property_area_regularization.property_id > property.property.id
